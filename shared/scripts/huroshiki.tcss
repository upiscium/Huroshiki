Screen {
    layout: vertical;
    background: $surface;
}

#screen-title {
    height: 3;
    padding: 1 2;
    text-style: bold;
    background: $primary;
    color: $text;
}

Input {
    margin: 1 2 0 2;
}

DataTable {
    height: 1fr;
    margin: 1 2;
    border: round $primary;
}

#key-help {
    height: 3;
    padding: 1 2;
    background: $panel;
    color: $text-muted;
}

.section-label,
#provider-label {
    height: 2;
    margin: 1 2 0 2;
    padding: 0 1;
    text-style: bold;
}

#project-actions-container,
#update-container {
    height: 1fr;
    width: 100%;
    align: center middle;
}

#project-actions {
    width: 46;
    height: auto;
    max-height: 14;
}

#settings-actions {
    width: 46;
    height: auto;
    max-height: 14;
}

#deployment-settings-form {
    height: 1fr;
    overflow-y: auto;
    padding-bottom: 1;
}

#client-distribution-content {
    height: 1fr;
    padding: 1 2;
}

#versions-settings-form {
    height: 1fr;
    padding: 1 2;
}

.readonly-setting {
    height: 2;
    margin: 0 2;
    padding: 0 1;
    color: $text-muted;
}

#loader-migration-status {
    height: auto;
    min-height: 3;
    margin: 1 2;
    padding: 1;
    border: round $primary;
}

#public-pack-url-source {
    height: 2;
    padding: 0 1;
    color: $text-muted;
}

#public-pack-url-display,
#public-pack-command-display {
    height: 5;
    margin: 0 2 1 2;
    border: round $primary;
}

#update-options {
    width: 1fr;
    height: 1fr;
}

#update-message {
    width: 100%;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#template-import-status,
#template-import-conflict-message,
#template-import-conflict-error,
#template-import-side-message,
#template-import-side-error,
#template-import-execution-status,
#template-import-order {
    height: auto;
    min-height: 2;
    margin: 0 2;
    padding: 0 1;
}

#template-import-order,
#template-import-conflict-error,
#template-import-side-error {
    color: $warning;
}

#template-import-candidates,
#template-import-conflicts,
#template-import-side-conflicts {
    min-height: 8;
}

#template-import-preview {
    height: 1fr;
    margin: 1 2;
    padding: 1 2;
    border: round $primary;
    overflow-y: auto;
}

ConfirmModal,
MessageModal,
PublicPackUrlEditModal,
NewPackModal,
CreateFromTemplateModal,
    NewTemplateModal,
    ContentCreateModal,
    ContentImportModal,
    ContentMoveModal {
    align: center middle;
    background: $background 60%;
}

#modal-dialog {
    width: 72;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#modal-dialog.wide-dialog {
    width: 90;
}

#modal-dialog.form-dialog {
    width: 78;
}

#modal-dialog Input,
#modal-dialog Select {
    margin: 0 0 1 0;
}

.modal-title {
    height: 2;
    text-style: bold;
    color: $accent;
}

#modal-message {
    height: auto;
    max-height: 60vh;
    overflow-y: auto;
    padding: 1 0;
}

.modal-help {
    height: 2;
    margin-top: 1;
    color: $text-muted;
}

#install-side-label,
#packwiz-status {
    height: 2;
    margin: 0 2;
    padding: 0 1;
}

#install-side-label {
    text-style: bold;
}

#packwiz-status {
    color: $text-muted;
}

#search-results-table {
    height: 2fr;
    min-height: 8;
}

#staged-table {
    height: 1fr;
    min-height: 7;
}


#template-editor {
    height: 1fr;
    margin: 1 2;
    border: round $primary;
}

#content-status,
#content-detail,
#content-editor-status,
#content-operation-status {
    height: auto;
    min-height: 2;
    margin: 0 2;
    padding: 0 1;
}

#content-detail,
#content-editor-status {
    color: $text-muted;
}

#content-table {
    min-height: 8;
}

#content-editor {
    height: 1fr;
    margin: 1 2;
    border: round $primary;
}

#content-create-text {
    height: 8;
    margin-bottom: 1;
    border: round $primary;
}

#content-plan-preview {
    height: 1fr;
    margin: 1 2;
    padding: 1 2;
    border: round $primary;
    overflow-y: auto;
}
